Options -MultiViews -Indexes
RewriteEngine On
RewriteBase /

# Permitir que PHP se ejecute directamente
RewriteRule \.php$ - [L]

# Permitir archivos y carpetas que existen físicamente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Todo lo demás va al index.html (SPA routing)
RewriteRule ^ index.html [L]
